# ───────────────────────────── Finah — configuração ─────────────────────────────
# Copie para .env e preencha. O .env NUNCA vai para o repositório.
#
# ATENÇÃO com o caractere $: o Docker Compose e o Next tratam "$ALGO" como variável e
# apagam esse trecho do valor, sem erro. Se uma senha de login (SEED_*_PASSWORD) tiver $,
# coloque o valor entre aspas simples: SEED_USER1_PASSWORD='minha$enha'.
# POSTGRES_PASSWORD/DATABASE_URL: só letras e números (o Next expande $ até entre aspas).

# ── Banco (Postgres 16) ──
# Usado pelo serviço `db` do Compose. Use uma senha só com letras e números
# (ela entra numa URL; caracteres como @ : / # quebrariam a conexão).
POSTGRES_USER=finah
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=finah
# Porta do Postgres publicada só em 127.0.0.1 (para desenvolvimento local)
DB_PORT=5432
# Conexão usada FORA do Compose (pnpm dev, pnpm db:migrate, pnpm db:seed).
# Dentro do Compose, app/worker/migrate usam automaticamente o host `db`.
DATABASE_URL=postgres://finah:troque-esta-senha@localhost:5432/finah

# ── Auth.js ──
# Segredo que assina os cookies de sessão. Gere com: openssl rand -base64 33
AUTH_SECRET=
# URL pública do app, COM https:// (opcional; só na VPS). Ex.: https://finah.seudominio.com.br
# Em desenvolvimento local deixe comentado.
# AUTH_URL=

# ── Seed: os 2 usuários e a conta principal (pnpm db:seed) ──
# Rodar o seed de novo redefine nome/senha/Telegram dos usuários para os valores abaixo,
# cria categorias que faltarem e NUNCA altera o saldo inicial de uma conta já criada.
SEED_USER1_NAME=Eduardo
SEED_USER1_EMAIL=
SEED_USER1_PASSWORD=
# ID numérico do Telegram (whitelist do bot; descubra com @userinfobot). Opcional.
SEED_USER1_TELEGRAM_ID=
# Cor do badge na UI (opcional, ex.: #2563eb)
SEED_USER1_COLOR=

SEED_USER2_NAME=
SEED_USER2_EMAIL=
SEED_USER2_PASSWORD=
SEED_USER2_TELEGRAM_ID=
SEED_USER2_COLOR=

SEED_ACCOUNT_NAME=Conta principal
# Saldo da conta no dia de início, como aparece no banco ("1.234,56"; negativo: "-150,00")
SEED_OPENING_BALANCE=0,00
# Dia de início do controle (AAAA-MM-DD)
SEED_OPENING_BALANCE_DATE=2026-10-01

# ── Rede ──
# Endereço público do app, só o nome (sem https:// e sem barra), ex.: finah.seudominio.com.br
# Precisa de um registro DNS tipo A apontando para o IP da VPS; o Caddy (perfil `vps`) emite o HTTPS sozinho.
# Sem domínio próprio: um subdomínio grátis do DuckDNS (ex.: finah-eduardo.duckdns.org) funciona.
# Pode ficar vazio se você não usar o perfil `vps` (dev local, NAS via Tailscale).
DOMAIN=
# Interface onde a porta do app é publicada. 127.0.0.1 na VPS (Caddy na frente);
# 0.0.0.0 para acessar pela rede local / Tailscale (NAS).
APP_BIND=127.0.0.1
APP_PORT=3000
# Imagem do app. Padrão: construída localmente. Para usar uma imagem publicada:
# FINAH_IMAGE=ghcr.io/<usuario>/finah:latest
# FINAH_IMAGE=

# ── Backup ──
# Expressão cron no fuso America/Sao_Paulo (padrão: todo dia às 03:00)
BACKUP_CRON="0 3 * * *"
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Pasta do host onde os dumps ficam
BACKUP_DIR=./backups
# Cópia off-site opcional: remoto do rclone (ex.: b2:finah-backups). Vazio = desligado.
# O rclone.conf fica em RCLONE_CONFIG_DIR/rclone.conf.
RCLONE_REMOTE=
RCLONE_CONFIG_DIR=./docker/backup/rclone

# ── Bot do Telegram ──
# off (padrão: bot desligado) | webhook (VPS: rota /api/webhooks/bot, depois rode `pnpm bot:webhook`)
# | polling (worker busca as mensagens; sem porta exposta — NAS ou teste local)
BOT_MODE=off
# Token do @BotFather
TELEGRAM_BOT_TOKEN=
# Segredo conferido no header X-Telegram-Bot-Api-Secret-Token (gere com: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
# O bot só responde aos SEED_USER*_TELEGRAM_ID cadastrados (rode o seed depois de preencher).

# ── LLM do bot (leitura das mensagens) ──
ANTHROPIC_API_KEY=
# Padrão: claude-opus-5-5 (esforço baixo). Para gastar menos: claude-haiku-5-5.
LLM_MODEL=claude-opus-5-5
